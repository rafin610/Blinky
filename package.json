{
  "name": "blinky",
  "version": "1.0.0",
  "description": "Blinky - 3D Intelligent Linux Desktop Companion",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ai": "esbuild scripts/test_ai.mts --bundle --platform=node --format=esm --outfile=/tmp/opencode/blinky-test-ai.mjs --log-level=error && node /tmp/opencode/blinky-test-ai.mjs",
    "test:ai:manager": "esbuild scripts/test_ai_manager.mts --bundle --platform=node --format=esm --outfile=/tmp/opencode/blinky-test-ai-manager.mjs --log-level=error && node /tmp/opencode/blinky-test-ai-manager.mjs 2>/dev/null | grep -E '^(PASS|FAIL|ALL)'",
    "build:model": "node scripts/build_glb.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0",
    "three": "^0.165.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.2"
  }
}